    let questions = [...rawQuestions];
    let currentIndex = 0;
    let userAnswers = {};
    let scores = {};

    function loadQuestion() {
      const q = questions[currentIndex];
      document.getElementById('qTitle').innerText = `${q.id}. ${q.question}`;
      
      const optionsContainer = document.getElementById('optionsContainer');
      optionsContainer.innerHTML = '';

      const isAnswered = userAnswers[currentIndex] !== undefined;

      Object.keys(q.options).forEach(key => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.innerText = `${key}) ${q.options[key]}`;

        if (userAnswers[currentIndex] === key) {
          btn.classList.add('selected');
        }

        if (isAnswered) {
          btn.disabled = true;
          if (key === q.answer) {
            btn.classList.add('correct');
          } else if (userAnswers[currentIndex] === key) {
            btn.classList.add('incorrect');
          }
        } else {
          btn.onclick = () => selectOption(key);
        }

        optionsContainer.appendChild(btn);
      });

      const expBox = document.getElementById('explanationBox');
      expBox.innerText = q.explanation;
      expBox.classList.remove('show');
      document.getElementById('explainBtn').innerText = "Show Explanation";

      document.getElementById('prevBtn').disabled = currentIndex === 0;
      document.getElementById('nextBtn').disabled = currentIndex === questions.length - 1;

      updateScoreBoard();
    }

    function selectOption(selectedKey) {
      const q = questions[currentIndex];
      userAnswers[currentIndex] = selectedKey;
      scores[currentIndex] = (selectedKey === q.answer);
      
      loadQuestion();
    }

    function toggleExplanation() {
      const expBox = document.getElementById('explanationBox');
      const btn = document.getElementById('explainBtn');
      if (expBox.classList.contains('show')) {
        expBox.classList.remove('show');
        btn.innerText = "Show Explanation";
      } else {
        expBox.classList.add('show');
        btn.innerText = "Hide Explanation";
      }
    }

    function prevQuestion() {
      if (currentIndex > 0) {
        currentIndex--;
        loadQuestion();
      }
    }

    function nextQuestion() {
      if (currentIndex < questions.length - 1) {
        currentIndex++;
        loadQuestion();
      }
    }

    function toggleRandomize() {
      const randomize = document.getElementById('randomizeToggle').checked;
      if (randomize) {
        questions = [...rawQuestions].sort(() => Math.random() - 0.5);
      } else {
        questions = [...rawQuestions];
      }
      currentIndex = 0;
      userAnswers = {};
      scores = {};
      loadQuestion();
    }

    function updateScoreBoard() {
      const answeredCount = Object.keys(userAnswers).length;
      const correctCount = Object.values(scores).filter(Boolean).length;
      document.getElementById('scoreBoard').innerText = `Score: ${correctCount} / ${answeredCount}`;
    }

    loadQuestion();
  </script>
